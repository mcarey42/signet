# Arguments passed to `signet serve`. See `signet serve -h`.
#
# Bind to localhost by default: exposing an unconfigured authority on a public
# interface is the wrong default even for a few minutes.
SIGNET_ARGS="-listen 127.0.0.1:8200"

# Metrics are off unless an address is given. Bind them somewhere that is not
# the API port.
#SIGNET_ARGS="-listen 127.0.0.1:8200 -metrics-listen 127.0.0.1:9101"

# Tracing is off unless a file is given. Read `signet trace help` — and
# SECURITY.md — before sharing a trace with anyone.
#SIGNET_ARGS="-listen 127.0.0.1:8200 -trace-file /var/lib/signet/trace.jsonl -trace-areas authz"
